                    <div class="bg-slate-900/50 p-2 rounded border border-slate-700 text-center shadow-inner"><span class="text-[10px] text-slate-400 block uppercase">RR</span><span class="text-emerald-300 font-medium">${log.vs.rr}</span></div>
                    <div class="bg-slate-900/50 p-2 rounded border border-slate-700 text-center shadow-inner"><span class="text-[10px] text-slate-400 block uppercase">SpO2</span><span class="text-emerald-300 font-medium">${log.vs.spo2}%</span></div>
                    <div class="bg-slate-900/50 p-2 rounded border border-slate-700 text-center shadow-inner"><span class="text-[10px] text-slate-400 block uppercase">DTX</span><span class="text-emerald-300 font-medium">${log.vs.dtx}</span></div>
                </div>
                <div class="mt-3 text-slate-300 text-xs flex justify-between bg-slate-900/50 p-2 rounded border border-slate-700">
                    <span><strong>GCS:</strong> ${log.vs.gcsE} ${log.vs.gcsV} ${log.vs.gcsM}</span>
                    <span><strong>Pupils:</strong> Rt. ${log.vs.pupilR} | Lt. ${log.vs.pupilL}</span>
                </div>
            ` : '<p class="text-slate-500 mt-2 text-xs italic">- ไม่มีข้อมูลสัญญาณชีพแบบละเอียดในระบบเก่า -</p>';

            document.getElementById('historyModalContent').innerHTML = `
                <div class="flex justify-between items-start border-b border-slate-700 pb-3 mb-4">
                    <div>
                        <p class="text-slate-400 text-xs mb-1">วันที่/เวลาเข้ารับบริการ</p>
                        <p class="text-white font-medium text-lg">${dt}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-slate-400 text-xs mb-1">ประเภท</p>
                        <span class="bg-blue-900/50 text-blue-400 border border-blue-500/30 px-2 py-1 rounded text-xs font-medium">${log.visitType}</span>
                    </div>
                </div>
                <div class="space-y-4">
                    <div>
                        <h4 class="text-emerald-400 font-semibold mb-2 flex items-center gap-2"><i class="fa-solid fa-comments-medical"></i> อาการสำคัญ (CC & PI)</h4>
                        <div class="text-slate-300 bg-slate-900/50 p-3 rounded border border-slate-700 text-sm space-y-2">
                            <p><strong class="text-slate-400">CC:</strong> ${log.cc || '-'}</p>
                            <p><strong class="text-slate-400">PI:</strong> ${log.pi || '-'}</p>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-emerald-400 font-semibold mb-2 flex items-center gap-2"><i class="fa-solid fa-heart-pulse"></i> สัญญาณชีพ (Vital Signs)</h4>
                        ${vsInfo}
