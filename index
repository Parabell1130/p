        window.onload = () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('reportFilterDate').value = today;
            
            if (isFirebaseActive) {
                document.getElementById('dbStatus').innerText = "ระบบจัดการคลินิกอัจฉริยะ (🟢 Online: Firebase Connected)";
                document.getElementById('dbStatus').classList.replace('text-slate-400', 'text-emerald-400');
                initFirebaseListeners();
            } else {
                // Initialize with Mock Data
                updateItemList();
                renderPatientTable();
                renderInventoryTable();
                initCharts();
                renderReports();
