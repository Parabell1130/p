                        </div>
                    </div>
                </div>
            `;
            document.getElementById('historyModal').classList.remove('hidden');
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').classList.add('hidden');
        }

        function handleLifeThreat(type) {
            const noneCb = document.getElementById('ltNone');
            const items = document.querySelectorAll('.lt-item');
            if (type === 'none' && noneCb.checked) {
                items.forEach(cb => cb.checked = false);
            } else if (type === 'item') {
                let hasItem = false;
                items.forEach(cb => { if(cb.checked) hasItem = true; });
                if(hasItem) noneCb.checked = false;
                else noneCb.checked = true;
            }
        }

        function updateItemList() {
            const type = document.getElementById('itemType').value;
            const sel = document.getElementById('itemSelect');
            sel.innerHTML = '';
            inventory.filter(i => i.type === type).forEach(i => {
                sel.innerHTML += `<option value="${i.id}">${i.name}</option>`;
            });
            updateStockDisplay();
        }

        function updateStockDisplay() {
            const id = document.getElementById('itemSelect').value;
            const badge = document.getElementById('stockBadge');
            const item = inventory.find(i => i.id === id);
            if(!item) return badge.innerText = "Stock: --";
            if(item.type === 'procedure') {
                badge.innerText = "Stock: ∞"; badge.className = "absolute right-2 top-2.5 text-[10px] bg-slate-700 px-1.5 py-0.5 rounded text-slate-300 font-medium";
            } else {
                badge.innerText = `Stock: ${item.stock}`;
                badge.className = `absolute right-2 top-2.5 text-[10px] px-1.5 py-0.5 rounded font-bold ${item.stock < 50 ? 'bg-red-500/20 text-red-400' : 'bg-slate-700 text-emerald-400'}`;
            }
        }

        function addItem() {
            const id = document.getElementById('itemSelect').value;
            const qty = parseInt(document.getElementById('itemQty').value);
            const item = inventory.find(i => i.id === id);
            
            if(!item || qty < 1) return;
            if(item.type !== 'procedure' && qty > item.stock) return alert(`สต๊อกไม่เพียงพอ! (คงเหลือ: ${item.stock})`);

            const exist = orderItems.find(i => i.id === id);
            if(exist) exist.qty += qty;
            else orderItems.push({ id, name: item.name, type: item.type, qty, unit: item.unit });

            // Update local memory stock (Firebase will update on save)
            if(item.type !== 'procedure') item.stock -= qty;
            
            document.getElementById('itemQty').value = 1;
            renderOrderList(); updateStockDisplay(); renderInventoryTable();
        }

        function removeOrderItem(id) {
            const idx = orderItems.findIndex(i => i.id === id);
            if(idx > -1) {
                const oItem = orderItems[idx];
                const invItem = inventory.find(i => i.id === id);
                if(invItem && invItem.type !== 'procedure') invItem.stock += oItem.qty; // Restore local stock
                orderItems.splice(idx, 1);
                renderOrderList(); updateStockDisplay(); renderInventoryTable();
            }
        }

        function renderOrderList() {
            const tbody = document.getElementById('orderList');
            tbody.innerHTML = '';
            if(orderItems.length === 0) return tbody.innerHTML = `<tr><td colspan="4" class="px-4 py-8 text-center text-slate-600">ยังไม่มีรายการ</td></tr>`;
            
            orderItems.forEach(item => {
                let badge = item.type === 'med' ? '<span class="text-blue-400">ยา</span>' : item.type === 'supply' ? '<span class="text-amber-400">เวชภัณฑ์</span>' : '<span class="text-purple-400">หัตถการ</span>';
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="px-4 py-2">${badge}</td>
                        <td class="px-4 py-2 text-slate-200">${item.name}</td>
                        <td class="px-4 py-2 text-center text-emerald-400 font-medium">${item.qty} ${item.unit}</td>
                        <td class="px-4 py-2 text-center">
                            <button onclick="removeOrderItem('${item.id}')" class="text-red-500 hover:text-red-400"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    </tr>`;
            });
        }

        function clearEMRForm() {
            ['patHn','patName','patGender','patAge','patNat','patCompany','patMed','patAllergy',
             'emrCC','emrPI','emrPE','emrDxDetail','vsBP','vsHR','vsRR','vsSpO2','vsDTX',
             'pupilR_mm','pupilL_mm'].forEach(id => {
                const el = document.getElementById(id); if(el) el.value = '';
            });
            ['gcsE','gcsV','gcsM','pupilR_react','pupilL_react'].forEach(id => {
                const el = document.getElementById(id); if(el) el.selectedIndex = 0;
            });

            // Restore cart items to local stock if clearing without saving
            orderItems.forEach(item => {
                const itemObj = inventory.find(i => i.id === item.id);
                if(itemObj && itemObj.type !== 'procedure') itemObj.stock += item.qty;
            });
            orderItems = [];
            renderOrderList(); updateStockDisplay(); renderInventoryTable();
            document.getElementById('ltNone').checked = true; handleLifeThreat('none');
            document.getElementById('pastHistorySection').classList.add('hidden');
        }

        async function saveEMRCase() {
            let hn = document.getElementById('patHn').value.trim();
            const name = document.getElementById('patName').value.trim();
            if(!name) return alert('กรุณาระบุชื่อผู้ป่วย');
            if(!hn) { hn = 'HN' + Math.floor(Math.random()*10000); document.getElementById('patHn').value = hn; }

            // Construct Patient Object (Update if new or changed)
            const patientObj = {
                hn: hn, name: name, 
                gender: document.getElementById('patGender').value || '-',
                age: parseInt(document.getElementById('patAge').value) || 0,
                nationality: document.getElementById('patNat').value || 'TH',
                company: document.getElementById('patCompany').value || '-',
                med: document.getElementById('patMed').value || '-',
                allergy: document.getElementById('patAllergy').value || '-'
            };

            // Gather Visit Data
            const dxSystem = document.getElementById('emrDxSystem').value || '-';
            const dxDetail = document.getElementById('emrDxDetail').value || '-';
            let visitType = 'ป่วยทั่วไป'; document.getElementsByName('visitType').forEach(r => { if(r.checked) visitType = r.nextElementSibling.innerText.trim(); });
            let plan = 'รับยา - D/C'; document.getElementsByName('plan').forEach(r => { if(r.checked) plan = r.value; });
            const itemsString = orderItems.length > 0 ? orderItems.map(i => `${i.name} (${i.qty})`).join(', ') : '-';

            // เก็บรายละเอียดเพิ่มเติมสำหรับแสดงผลย้อนหลัง
            const cc = document.getElementById('emrCC').value || '-';
            const pi = document.getElementById('emrPI').value || '-';
            const pe = document.getElementById('emrPE').value || '-';
            const vs = {
                bp: document.getElementById('vsBP').value || '-', hr: document.getElementById('vsHR').value || '-',
                rr: document.getElementById('vsRR').value || '-', spo2: document.getElementById('vsSpO2').value || '-', dtx: document.getElementById('vsDTX').value || '-',
                gcsE: document.getElementById('gcsE').value, gcsV: document.getElementById('gcsV').value, gcsM: document.getElementById('gcsM').value,
                pupilR: document.getElementById('pupilR_mm').value + 'mm ' + document.getElementById('pupilR_react').value,
                pupilL: document.getElementById('pupilL_mm').value + 'mm ' + document.getElementById('pupilL_react').value
            };

            const newCase = {
                timestamp: new Date().toISOString(),
                hn: patientObj.hn, name: patientObj.name, gender: patientObj.gender, company: patientObj.company, 
                visitType, dxSystem, dx: dxDetail, plan, items: itemsString,
                cc: cc, pi: pi, pe: pe, vs: vs
            };

            // Database Operations
            try {
                if (isFirebaseActive) {
                    // 1. Save/Update Patient
                    await db.collection("patients").doc(patientObj.hn).set(patientObj, { merge: true });
                    
                    // 2. Add Visit Log
                    await db.collection("visits").add(newCase);
                    
                    // 3. Deduct Inventory Stock in Firebase
                    for (const item of orderItems) {
                        if (item.type !== 'procedure') {
                            const invRef = db.collection("inventory").doc(item.id);
                            // Using standard read/write for simplicity. Note: production usually uses Transactions or increment.
                            const docSnap = await invRef.get();
                            if(docSnap.exists) {
                                const currentStock = docSnap.data().stock;
                                await invRef.update({ stock: currentStock - item.qty });
                            }
                        }
                    }
                } else {
                    // Local Memory Update
                    const pIdx = patientsDB.findIndex(p => p.hn === patientObj.hn);
                    if(pIdx > -1) patientsDB[pIdx] = patientObj; else patientsDB.push(patientObj);
                    visitLogs.push(newCase);
                }

                // Google Sheets Backup (Always run if URL exists)
                const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbysXB4mr-VL-2waYUm-XBZs5OnCyqz9N2YaUotGISZ6qum7NgbDsdb8OwPAkd3IY3_r/exec"; // ใส่ URL ที่นี่
                if(GOOGLE_SCRIPT_URL) {
                    fetch(GOOGLE_SCRIPT_URL, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(newCase) }).catch(e=>console.error("Sheets err:",e));
                }

                alert('บันทึกเคสการรักษาเรียบร้อยแล้ว!');
                orderItems = []; // clear cart explicitly so clearEMRForm doesn't restore local stock
                clearEMRForm(); renderReports(); switchView('reports');

            } catch (error) {
                console.error("Save Error:", error);
                alert("เกิดข้อผิดพลาดในการบันทึก: " + error.message);
            }
        }

        function renderInventoryTable() {
            const tbody = document.getElementById('inventoryTableBody');
            const search = document.getElementById('searchInv').value.toLowerCase();
            const filterType = document.getElementById('filterInvType').value;
            tbody.innerHTML = '';
            
            inventory.forEach(item => {
                if(filterType !== 'ALL' && item.type !== filterType) return;
                if(search && !item.name.toLowerCase().includes(search) && !item.id.toLowerCase().includes(search)) return;

                let typeBadge = item.type === 'med' ? '<span class="bg-blue-900/50 text-blue-400 text-[10px] px-2 py-1 rounded border border-blue-700/50">ยา</span>' : 
                                item.type === 'supply' ? '<span class="bg-amber-900/50 text-amber-400 text-[10px] px-2 py-1 rounded border border-amber-700/50">เวชภัณฑ์</span>' : 
                                '<span class="bg-purple-900/50 text-purple-400 text-[10px] px-2 py-1 rounded border border-purple-700/50">หัตถการ</span>';

                let stockText = item.stock; let stockStyle = "text-slate-300";
                if(item.type === 'procedure') { stockText = '-'; stockStyle = "text-slate-500"; } 
                else if(item.stock < 50) { stockStyle = "text-red-400 font-bold bg-red-500/10 px-2 py-1 rounded"; } 
                else { stockStyle = "text-emerald-400 font-medium"; }

                let expText = '-'; let expStyle = "text-slate-400";
                if(item.type !== 'procedure' && item.expiry) {
                    expText = item.expiry;
                    const diffDays = Math.ceil((new Date(item.expiry) - new Date()) / (1000 * 60 * 60 * 24));
                    if (diffDays < 0) { expStyle = "text-red-400 font-bold bg-red-500/10 px-2 py-1 rounded"; expText = "หมดอายุ"; } 
                    else if (diffDays <= 90) { expStyle = "text-orange-400 font-bold"; }
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="px-4 py-3 font-mono text-slate-400">${item.id}</td>
                        <td class="px-4 py-3 font-medium text-slate-200">${item.name}</td>
                        <td class="px-4 py-3 text-center">${typeBadge}</td>
                        <td class="px-4 py-3 text-right"><span class="${stockStyle}">${stockText}</span></td>
                        <td class="px-4 py-3 text-center text-slate-500 text-xs">${item.unit}</td>
                        <td class="px-4 py-3 text-center text-xs"><span class="${expStyle}">${expText}</span></td>
                        <td class="px-4 py-3 text-center">
                            <button onclick="editInvItem('${item.id}')" class="text-blue-400 hover:text-blue-300 transition mr-3"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button onclick="deleteInvItem('${item.id}')" class="text-red-500 hover:text-red-400 transition"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    </tr>`;
            });
        }

        async function saveInventoryItem(e) {
            e.preventDefault();
            const mode = document.getElementById('invMode').value;
            const id = document.getElementById('invId').value.trim();
            const newItem = {
                id: id,
                name: document.getElementById('invName').value.trim(),
                type: document.getElementById('invType').value,
                stock: parseInt(document.getElementById('invStock').value),
                unit: document.getElementById('invUnit').value.trim(),
                expiry: document.getElementById('invExpiry').value
            };

            if(mode === 'add' && inventory.find(i => i.id === id)) return alert('รหัสนี้มีอยู่แล้ว');

            if(isFirebaseActive) {
                await db.collection("inventory").doc(id).set(newItem);
            } else {
                if(mode === 'add') inventory.push(newItem);
                else { const idx = inventory.findIndex(i => i.id === id); if(idx > -1) inventory[idx] = newItem; }
                renderInventoryTable(); updateItemList();
            }
            clearInvForm();
        }

        function editInvItem(id) {
            const item = inventory.find(i => i.id === id); if(!item) return;
            document.getElementById('invMode').value = 'edit';
            document.getElementById('invId').value = item.id; document.getElementById('invId').readOnly = true;
            document.getElementById('invName').value = item.name; document.getElementById('invType').value = item.type;
            document.getElementById('invStock').value = item.stock; document.getElementById('invUnit').value = item.unit;
            document.getElementById('invExpiry').value = item.expiry || '';
        }

        async function deleteInvItem(id) {
            if(confirm('ลบรายการนี้ออกจากระบบ?')) {
                if (isFirebaseActive) {
                    await db.collection("inventory").doc(id).delete();
                } else {
                    inventory = inventory.filter(i => i.id !== id);
                    renderInventoryTable(); updateItemList();
                }
            }
        }

        function clearInvForm() {
            document.getElementById('invMode').value = 'add';
            document.getElementById('invId').value = ''; document.getElementById('invId').readOnly = false;
            document.getElementById('invName').value = ''; document.getElementById('invStock').value = '';
            document.getElementById('invUnit').value = ''; document.getElementById('invExpiry').value = '';
        }

        function initCharts() {
            Chart.defaults.color = '#94a3b8';
            Chart.defaults.font.family = "'IBM Plex Sans Thai', sans-serif";
            const createDoughnut = (ctxId) => new Chart(document.getElementById(ctxId).getContext('2d'), {
                type: 'doughnut', data: { labels: [], datasets: [{ data: [], backgroundColor: ['#10b981','#3b82f6','#f59e0b','#ef4444','#8b5cf6','#64748b'], borderWidth: 0 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right', labels: { boxWidth: 10, font: {size: 10} } } }, cutout: '70%' }
            });
            charts.company = new Chart(document.getElementById('companyChart').getContext('2d'), {
                type: 'bar', data: { labels: [], datasets: [{ data: [], backgroundColor: '#10b981', borderRadius: 4 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: '#334155' } }, x: { grid: { display: false } } } }
            });
            charts.dx = createDoughnut('dxChart');
            charts.plan = createDoughnut('planChart');
            charts.gender = createDoughnut('genderChart');
        }

        function renderPatientTable() {
            const tbody = document.getElementById('patientTableBody');
            const search = document.getElementById('dbSearchInput').value.toLowerCase();
            const filterCo = document.getElementById('filterCompany').value;
            tbody.innerHTML = '';
            patientsDB.forEach(p => {
                if(filterCo !== 'ALL' && p.company !== filterCo) return;
                if(search && !p.name.toLowerCase().includes(search) && !p.hn.toLowerCase().includes(search)) return;
                const allergyStyle = p.allergy !== '-' ? 'text-red-400 font-semibold' : 'text-slate-500';
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="px-4 py-3 font-medium text-emerald-400">${p.hn}</td>
                        <td class="px-4 py-3 text-slate-200">${p.name}</td>
                        <td class="px-4 py-3 text-slate-400">${p.gender} / ${p.age}</td>
                        <td class="px-4 py-3 text-slate-400">${p.company}</td>
                        <td class="px-4 py-3"><span class="block text-xs text-slate-400">โรค: ${p.med}</span><span class="block text-xs ${allergyStyle}">แพ้: ${p.allergy}</span></td>
                        <td class="px-4 py-3 text-center">
                            <button onclick="sendToEMR('${p.hn}')" class="bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600 hover:text-white px-3 py-1.5 rounded text-xs transition border border-emerald-500/30"><i class="fa-solid fa-file-medical"></i> ส่งตรวจ</button>
                        </td>
                    </tr>`;
            });
        }

        function sendToEMR(hn) {
            document.getElementById('quickSearchInput').value = hn;
            quickSearchPatient();
            switchView('emr');
        }

        function updateReportFilterUI() {
            const type = document.getElementById('reportFilterType').value;
            ['reportFilterDate', 'reportFilterMonth', 'reportFilterYear'].forEach(id => document.getElementById(id).classList.add('hidden'));
            if(type === 'daily') document.getElementById('reportFilterDate').classList.remove('hidden');
            if(type === 'monthly') document.getElementById('reportFilterMonth').classList.remove('hidden');
            if(type === 'yearly') document.getElementById('reportFilterYear').classList.remove('hidden');
            renderReports();
        }

        function renderReports() {
            const type = document.getElementById('reportFilterType').value;
            let filterValue = type === 'daily' ? document.getElementById('reportFilterDate').value : type === 'monthly' ? document.getElementById('reportFilterMonth').value : document.getElementById('reportFilterYear').value;
            const logs = visitLogs.filter(log => !filterValue || log.timestamp.startsWith(filterValue));

            let workAcc = 0, refer = 0;
            let cComp = {}, cDx = {}, cPlan = {}, cGender = {};

            logs.forEach(log => {
                if(log.visitType.includes('อุบัติเหตุในงาน')) workAcc++;
                if(log.plan.includes('Refer') || log.plan.includes('ส่งต่อ')) refer++;
                cComp[log.company] = (cComp[log.company] || 0) + 1; cDx[log.dxSystem] = (cDx[log.dxSystem] || 0) + 1;
                cPlan[log.plan] = (cPlan[log.plan] || 0) + 1; cGender[log.gender] = (cGender[log.gender] || 0) + 1;
            });

            document.getElementById('statTotal').innerText = logs.length; document.getElementById('statWorkAcc').innerText = workAcc;
            document.getElementById('statGen').innerText = logs.length - workAcc; document.getElementById('statRefer').innerText = refer;

            if(charts.company) {
                charts.company.data.labels = Object.keys(cComp); charts.company.data.datasets[0].data = Object.values(cComp); charts.company.update();
                charts.dx.data.labels = Object.keys(cDx); charts.dx.data.datasets[0].data = Object.values(cDx); charts.dx.update();
                charts.plan.data.labels = Object.keys(cPlan); charts.plan.data.datasets[0].data = Object.values(cPlan); charts.plan.update();
                const lang = document.getElementById('reportLang').value;
                const tGen = lang === 'th' ? {'M':'ชาย','F':'หญิง','O':'อื่นๆ','-':'-'} : lang === 'en' ? {'M':'Male','F':'Female','O':'Other','-':'-'} : {'M':'男','F':'女','O':'其他','-':'-'};
                charts.gender.data.labels = Object.keys(cGender).map(k => tGen[k] || k); charts.gender.data.datasets[0].data = Object.values(cGender); charts.gender.update();
            }

            const tbody = document.getElementById('reportTableBody'); tbody.innerHTML = '';
            if(logs.length === 0) return tbody.innerHTML = `<tr><td colspan="10" class="px-3 py-6 text-center text-slate-500">ไม่มีข้อมูล</td></tr>`;

            logs.sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp)).forEach(log => {
                const d = new Date(log.timestamp);
                const dt = `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="px-3 py-2 text-slate-400">${dt}</td><td class="px-3 py-2 text-emerald-400 font-medium">${log.hn}</td>
                        <td class="px-3 py-2 text-slate-300">${log.name}</td><td class="px-3 py-2 text-slate-400">${log.gender}</td>
                        <td class="px-3 py-2">${log.company}</td><td class="px-3 py-2">${log.visitType}</td><td class="px-3 py-2 text-purple-400">${log.dxSystem}</td>
                        <td class="px-3 py-2 text-yellow-400">${log.dx}</td><td class="px-3 py-2 ${log.plan.includes('Refer') ? 'text-red-400' : 'text-blue-400'}">${log.plan}</td>
                        <td class="px-3 py-2 truncate max-w-[150px]" title="${log.items}">${log.items}</td>
                    </tr>`;
            });
            translateReports();
        }

        const trans = {
            th: { title: "สรุปรายงานสถิติคลินิก", total: "จำนวนเคสทั้งหมด (ครั้ง)", work: "อุบัติเหตุในงาน", gen: "ป่วย/อุบัติเหตุทั่วไป", refer: "ฉุกเฉิน / รีเฟอร์", comp: "สถิติแยกตามบริษัท", dx: "สถิติแยกระบบร่างกาย", plan: "สถิติแผนการรักษา", genCh: "สถิติแยกตามเพศ" },
            en: { title: "Clinic Statistical Report", total: "Total Cases", work: "Work Accident", gen: "Gen. Illness/Accident", refer: "Emergency / Refer", comp: "Cases by Company", dx: "Cases by System (Dx)", plan: "Treatment Plan", genCh: "Cases by Gender" },
            cn: { title: "诊所统计报告", total: "总病例 (次)", work: "工伤", gen: "一般疾病/意外", refer: "急诊 / 转院", comp: "按公司统计", dx: "按身体系统统计", plan: "按治疗方案统计", genCh: "按性别统计" }
        };

        function translateReports() {
            const lang = document.getElementById('reportLang').value; const t = trans[lang];
            document.getElementById('lblTotal').innerText = t.total; document.getElementById('lblWork').innerText = t.work;
            document.getElementById('lblGen').innerText = t.gen; document.getElementById('lblRefer').innerText = t.refer;
            document.getElementById('lblCompChart').innerText = t.comp; document.getElementById('lblDxChart').innerText = t.dx;
            document.getElementById('lblPlanChart').innerText = t.plan; document.getElementById('lblGenChart').innerText = t.genCh;
            document.getElementById('printTitle').innerText = t.title; document.getElementById('pLblTotal').innerText = t.total; 
            document.getElementById('pLblWork').innerText = t.work; document.getElementById('pLblGen').innerText = t.gen; 
            document.getElementById('pLblRefer').innerText = t.refer; document.getElementById('pLblComp').innerText = t.comp; 
            document.getElementById('pLblDx').innerText = t.dx; document.getElementById('pLblPlan').innerText = t.plan; 
            document.getElementById('pLblGender').innerText = t.genCh;
            renderReportsGenderChartLabel(lang);
        }

        function renderReportsGenderChartLabel(lang) {
            const type = document.getElementById('reportFilterType').value;
            let filterValue = type === 'daily' ? document.getElementById('reportFilterDate').value : type === 'monthly' ? document.getElementById('reportFilterMonth').value : document.getElementById('reportFilterYear').value;
            const logs = visitLogs.filter(log => !filterValue || log.timestamp.startsWith(filterValue));
            let cGender = {}; logs.forEach(log => { cGender[log.gender] = (cGender[log.gender] || 0) + 1; });
            const tGen = lang === 'th' ? {'M':'ชาย','F':'หญิง','O':'อื่นๆ','-':'-'} : lang === 'en' ? {'M':'Male','F':'Female','O':'Other','-':'-'} : {'M':'男','F':'女','O':'其他','-':'-'};
            charts.gender.data.labels = Object.keys(cGender).map(k => tGen[k] || k); charts.gender.update();
        }

        function printA4() {
            translateReports();
            const type = document.getElementById('reportFilterType').value;
            let v = type === 'daily' ? document.getElementById('reportFilterDate').value : type === 'monthly' ? document.getElementById('reportFilterMonth').value : document.getElementById('reportFilterYear').value;
            document.getElementById('printDateRange').innerText = v || "ทั้งหมด";
            document.getElementById('pStatTotal').innerText = document.getElementById('statTotal').innerText; document.getElementById('pStatWork').innerText = document.getElementById('statWorkAcc').innerText;
            document.getElementById('pStatGen').innerText = document.getElementById('statGen').innerText; document.getElementById('pStatRefer').innerText = document.getElementById('statRefer').innerText;
            
            Chart.defaults.color = '#000'; charts.company.update(); charts.dx.update(); charts.plan.update(); charts.gender.update();
            setTimeout(() => {
                document.getElementById('printImgComp').src = document.getElementById('companyChart').toDataURL('image/png'); document.getElementById('printImgDx').src = document.getElementById('dxChart').toDataURL('image/png');
                document.getElementById('printImgPlan').src = document.getElementById('planChart').toDataURL('image/png'); document.getElementById('printImgGender').src = document.getElementById('genderChart').toDataURL('image/png');
                window.print();
                Chart.defaults.color = '#94a3b8'; charts.company.update(); charts.dx.update(); charts.plan.update(); charts.gender.update();
            }, 500);
        }

        function exportToExcel() {
            const table = document.getElementById('reportTable'); const wb = XLSX.utils.table_to_book(table, {sheet: "Report"});
            const type = document.getElementById('reportFilterType').value;
            let filterValue = type === 'daily' ? document.getElementById('reportFilterDate').value : type === 'monthly' ? document.getElementById('reportFilterMonth').value : document.getElementById('reportFilterYear').value;
            XLSX.writeFile(wb, `Clinic_Report_${type.charAt(0).toUpperCase() + type.slice(1)}_${filterValue || new Date().getTime()}.xlsx`);
        }
        
        function exportInventoryToExcel() {
            const wb = XLSX.utils.table_to_book(document.getElementById('inventoryTableExport'), {sheet: "Inventory"});
            XLSX.writeFile(wb, `Clinic_Inventory_${new Date().getTime()}.xlsx`);
        }
    </script>
