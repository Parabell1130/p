                alert('ไม่พบประวัติผู้ป่วยในระบบ');
                document.getElementById('pastHistorySection').classList.add('hidden');
            }
        }

        function renderPatientHistory(hn) {
            const historyBody = document.getElementById('pastHistoryBody');
            const historySec = document.getElementById('pastHistorySection');
            historyBody.innerHTML = '';
            
            const pLogs = visitLogs.filter(l => l.hn === hn).sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp));
            
            if(pLogs.length === 0) {
                historyBody.innerHTML = `<tr><td colspan="6" class="px-3 py-4 text-center text-slate-500">ไม่มีประวัติการรักษาเก่า</td></tr>`;
            } else {
                pLogs.forEach(log => {
                    const d = new Date(log.timestamp);
                    const dt = `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
                    historyBody.innerHTML += `
                        <tr class="hover:bg-slate-700/50 transition cursor-pointer" onclick="viewHistoryDetail('${log.timestamp}')">
                            <td class="px-3 py-2 text-slate-400">${dt}</td>
                            <td class="px-3 py-2 text-blue-400">${log.visitType}</td>
                            <td class="px-3 py-2 text-amber-400 truncate max-w-[120px]">${log.dx}</td>
                            <td class="px-3 py-2 text-slate-300">${log.plan}</td>
                            <td class="px-3 py-2 text-slate-400 truncate max-w-[120px]" title="${log.items}">${log.items}</td>
                            <td class="px-3 py-2 text-center text-emerald-400"><i class="fa-solid fa-eye hover:scale-110 transition"></i></td>
                        </tr>
                    `;
                });
            }
            historySec.classList.remove('hidden');
        }

        // ฟังก์ชันเปิดดูรายละเอียดเคสย้อนหลัง
