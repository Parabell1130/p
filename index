<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clinic EMR & Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <!-- Firebase SDK (Compat version for single file usage) -->
    <script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore-compat.js"></script>

    <style>
        body { font-family: 'IBM Plex Sans Thai', sans-serif; background-color: #0f172a; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #10b981; }
        
        .check-card:checked + div { background-color: #047857; border-color: #10b981; color: white; }
        .esi-1:checked + div { background-color: #b91c1c; border-color: #ef4444; color: white; }
        .esi-2:checked + div { background-color: #c2410c; border-color: #f97316; color: white; }
        .esi-3:checked + div { background-color: #a16207; border-color: #eab308; color: white; }
        .esi-4:checked + div { background-color: #15803d; border-color: #22c55e; color: white; }
        .esi-5:checked + div { background-color: #1d4ed8; border-color: #3b82f6; color: white; }

        .view-section { display: none; }
        .view-section.active { display: block; animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .nav-btn.active { background-color: rgba(16, 185, 129, 0.15); color: #34d399; border-bottom: 2px solid #10b981; }

        /* Print Styles */
        @media print {
            body * { visibility: hidden; }
            #printArea, #printArea * { visibility: visible; }
            #printArea { position: absolute; left: 0; top: 0; width: 100%; background: white !important; color: black !important; padding: 20px;}
            .no-print { display: none !important; }
            canvas { max-width: 100% !important; height: auto !important; }
        }
    </style>
</head>
<body class="text-slate-200 min-h-screen pb-12 flex flex-col">

    <header class="bg-slate-900 border-b border-emerald-600/30 sticky top-0 z-50 shadow-lg no-print">
        <div class="px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-emerald-500/20 p-2.5 rounded-lg text-emerald-400">
                    <i class="fa-solid fa-notes-medical text-xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-emerald-400 leading-none">Clinic EMR System</h1>
                    <p class="text-slate-400 text-sm mt-1" id="dbStatus">ระบบจัดการคลินิกอัจฉริยะ (Offline Mode)</p>
                </div>
            </div>
            <div class="flex items-center gap-4 text-slate-400">
                <div class="flex items-center gap-2 border-l border-slate-700 pl-4">
                    <div class="w-8 h-8 rounded-full bg-emerald-700 flex items-center justify-center text-white text-sm font-bold">N</div>
                    <span class="text-sm">พยาบาลวิชาชีพ</span>
                </div>
            </div>
        </div>
        
        <nav class="flex px-6 border-t border-slate-800">
            <button onclick="switchView('emr')" id="nav-emr" class="nav-btn active px-6 py-3 text-sm font-medium text-slate-400 hover:text-emerald-300 transition flex items-center gap-2"><i class="fa-solid fa-stethoscope"></i> ตรวจรักษา (EMR)</button>
            <button onclick="switchView('patients')" id="nav-patients" class="nav-btn px-6 py-3 text-sm font-medium text-slate-400 hover:text-emerald-300 transition flex items-center gap-2"><i class="fa-solid fa-users"></i> ทะเบียนผู้ป่วย</button>
            <button onclick="switchView('inventory')" id="nav-inventory" class="nav-btn px-6 py-3 text-sm font-medium text-slate-400 hover:text-emerald-300 transition flex items-center gap-2"><i class="fa-solid fa-boxes-stacked"></i> คลังยา/สต๊อก</button>
            <button onclick="switchView('reports')" id="nav-reports" class="nav-btn px-6 py-3 text-sm font-medium text-slate-400 hover:text-emerald-300 transition flex items-center gap-2"><i class="fa-solid fa-chart-pie"></i> รายงานสถิติ</button>
        </nav>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 mt-6 no-print">

        <div id="view-emr" class="view-section active space-y-6">
            <section class="bg-slate-900 rounded-xl border border-slate-800 shadow-lg p-5">
                <div class="flex justify-between items-center mb-4 border-b border-slate-800 pb-3">
                    <h2 class="text-lg font-semibold text-emerald-300 flex items-center gap-2"><i class="fa-solid fa-id-card"></i> 1. ข้อมูลผู้ป่วย (Patient Info)</h2>
                    <div class="flex items-center gap-2">
                        <div class="flex w-72">
                            <input type="text" id="quickSearchInput" placeholder="ค้นหาด้วย HN หรือ ชื่อ..." class="w-full bg-slate-800 border border-slate-700 rounded-l-lg p-2 text-sm focus:border-emerald-500 focus:outline-none" onkeyup="if(event.key === 'Enter') quickSearchPatient()">
                            <button onclick="quickSearchPatient()" class="bg-slate-700 hover:bg-slate-600 border border-slate-700 border-l-0 rounded-r-lg px-3 text-slate-300 transition"><i class="fa-solid fa-magnifying-glass"></i></button>
                        </div>
                        <button onclick="clearEMRForm()" class="bg-blue-600/20 text-blue-400 border border-blue-500/30 hover:bg-blue-600/40 px-3 py-2 rounded-lg text-sm transition"><i class="fa-solid fa-eraser"></i> เคลียร์</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Patient No. (HN)</label>
                        <input type="text" id="patHn" placeholder="สร้างอัตโนมัติ" readonly class="w-full bg-slate-800/50 border border-slate-700 rounded-lg p-2 text-sm text-slate-500 cursor-not-allowed">
                    </div>
                    <div class="lg:col-span-2">
                        <label class="block text-xs font-medium text-slate-400 mb-1">ชื่อ-สกุล</label>
                        <input type="text" id="patName" placeholder="ระบุชื่อ-นามสกุล" class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm transition">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">เพศ</label>
                        <select id="patGender" class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm transition">
                            <option value="">-- เลือก --</option>
                            <option value="M">ชาย (Male)</option>
                            <option value="F">หญิง (Female)</option>
                            <option value="O">อื่นๆ (Other)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">อายุ (ปี)</label>
                        <input type="number" id="patAge" placeholder="อายุ" class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm transition">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">สัญชาติ</label>
                        <select id="patNat" class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm transition">
                            <option value="TH">ไทย</option><option value="MM">เมียนมา</option><option value="LA">ลาว</option><option value="KH">กัมพูชา</option><option value="OTHER">อื่นๆ</option>
                        </select>
                    </div>
                    <div class="lg:col-span-2">
                        <label class="block text-xs font-medium text-slate-400 mb-1">สถานที่ทำงาน (บริษัท)</label>
                        <select id="patCompany" class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm transition">
                            <option value="">-- เลือกบริษัท --</option>
                            <option value="Company A">Company A (โรงงานหลัก)</option>
                            <option value="Company B">Company B (คลังสินค้า)</option>
                            <option value="Company C">Company C (สำนักงาน)</option>
                        </select>
                    </div>
                    <div class="lg:col-span-2">
                        <label class="block text-xs font-medium text-slate-400 mb-1">โรคประจำตัว (Medical Problem)</label>
                        <input type="text" id="patMed" placeholder="ปฏิเสธ / ระบุโรค" class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm transition">
                    </div>
                    <div class="lg:col-span-2">
                        <label class="block text-xs font-medium text-red-400 mb-1">ประวัติแพ้ยา/อาหาร (Allergy)</label>
                        <input type="text" id="patAllergy" placeholder="ปฏิเสธ / ระบุสิ่งที่แพ้" class="w-full bg-slate-800 border border-red-900/50 rounded-lg p-2 focus:border-red-500 focus:outline-none text-sm text-red-200 placeholder-red-800/50 transition">
                    </div>
                </div>

                <!-- Past History Section -->
                <div id="pastHistorySection" class="hidden mt-4 pt-4 border-t border-slate-800">
                    <h3 class="text-sm font-medium text-emerald-400 mb-2 flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left"></i> ประวัติการรักษาย้อนหลัง (Visit History)</h3>
                    <div class="overflow-auto max-h-40 border border-slate-700 rounded-lg bg-slate-950/50">
                        <table class="w-full text-left text-xs text-slate-300">
                            <thead class="bg-slate-800 text-slate-400 sticky top-0">
                                <tr><th class="px-3 py-2">วันที่/เวลา</th><th class="px-3 py-2">ประเภท</th><th class="px-3 py-2">วินิจฉัย (Dx)</th><th class="px-3 py-2">แผนการรักษา</th><th class="px-3 py-2">รายการที่จ่าย</th><th class="px-3 py-2 text-center w-12"><i class="fa-solid fa-magnifying-glass"></i></th></tr>
                            </thead>
                            <tbody id="pastHistoryBody" class="divide-y divide-slate-800"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <div class="lg:col-span-6 space-y-6">
                    <section class="bg-slate-900 rounded-xl border border-slate-800 shadow-lg p-5">
                        <h2 class="text-lg font-semibold text-emerald-300 mb-4 flex items-center gap-2 border-b border-slate-800 pb-3"><i class="fa-solid fa-truck-medical"></i> 2. การคัดกรอง (Triage)</h2>
                        
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-slate-400 mb-2">ระดับความรู้สึกตัว (AVPU)</label>
                            <div class="grid grid-cols-4 gap-2">
                                <label class="cursor-pointer"><input type="radio" name="avpu" class="check-card sr-only" checked><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">Alert</div></label>
                                <label class="cursor-pointer"><input type="radio" name="avpu" class="check-card sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">Verbal</div></label>
                                <label class="cursor-pointer"><input type="radio" name="avpu" class="check-card sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">Painful</div></label>
                                <label class="cursor-pointer"><input type="radio" name="avpu" class="check-card sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">Unresponsive</div></label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-medium text-slate-400 mb-2">ESI Triage Level</label>
                            <div class="grid grid-cols-5 gap-2">
                                <label class="cursor-pointer"><input type="radio" name="esi" class="esi-1 sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">1 Resus</div></label>
                                <label class="cursor-pointer"><input type="radio" name="esi" class="esi-2 sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">2 Emerg</div></label>
                                <label class="cursor-pointer"><input type="radio" name="esi" class="esi-3 sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">3 Urgent</div></label>
                                <label class="cursor-pointer"><input type="radio" name="esi" class="esi-4 sr-only" checked><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">4 Less Urg</div></label>
                                <label class="cursor-pointer"><input type="radio" name="esi" class="esi-5 sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">5 Non Urg</div></label>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-400 mb-2">ภาวะคุกคามต่อชีวิต (Life Threatening)</label>
                            <div class="flex flex-wrap gap-2">
                                <label class="cursor-pointer"><input type="checkbox" id="ltNone" class="check-card sr-only" checked onchange="handleLifeThreat('none')"><div class="px-3 py-1.5 border border-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-800 transition">ไม่มี (None)</div></label>
                                <label class="cursor-pointer"><input type="checkbox" class="lt-item check-card sr-only" onchange="handleLifeThreat('item')"><div class="px-3 py-1.5 border border-red-900/50 rounded-lg text-xs font-semibold text-red-400 hover:bg-slate-800 transition">Cardiac arrest</div></label>
                                <label class="cursor-pointer"><input type="checkbox" class="lt-item check-card sr-only" onchange="handleLifeThreat('item')"><div class="px-3 py-1.5 border border-red-900/50 rounded-lg text-xs font-semibold text-red-400 hover:bg-slate-800 transition">Ex Hemorrhage</div></label>
                                <label class="cursor-pointer"><input type="checkbox" class="lt-item check-card sr-only" onchange="handleLifeThreat('item')"><div class="px-3 py-1.5 border border-orange-900/50 rounded-lg text-xs font-semibold text-orange-400 hover:bg-slate-800 transition">Airway</div></label>
                                <label class="cursor-pointer"><input type="checkbox" class="lt-item check-card sr-only" onchange="handleLifeThreat('item')"><div class="px-3 py-1.5 border border-orange-900/50 rounded-lg text-xs font-semibold text-orange-400 hover:bg-slate-800 transition">Breathing</div></label>
                                <label class="cursor-pointer"><input type="checkbox" class="lt-item check-card sr-only" onchange="handleLifeThreat('item')"><div class="px-3 py-1.5 border border-orange-900/50 rounded-lg text-xs font-semibold text-orange-400 hover:bg-slate-800 transition">Circulation</div></label>
                                <label class="cursor-pointer"><input type="checkbox" class="lt-item check-card sr-only" onchange="handleLifeThreat('item')"><div class="px-3 py-1.5 border border-yellow-900/50 rounded-lg text-xs font-semibold text-yellow-400 hover:bg-slate-800 transition">Disability</div></label>
                            </div>
                        </div>
                    </section>

                    <section class="bg-slate-900 rounded-xl border border-slate-800 shadow-lg p-5">
                        <h2 class="text-lg font-semibold text-emerald-300 mb-4 flex items-center gap-2 border-b border-slate-800 pb-3"><i class="fa-solid fa-comments-medical"></i> 3. การซักประวัติ (History Taking)</h2>
                        <div class="space-y-4">
                            <div class="grid grid-cols-4 gap-2">
                                <label class="cursor-pointer"><input type="radio" name="visitType" class="check-card sr-only" checked><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">ป่วยทั่วไป</div></label>
                                <label class="cursor-pointer"><input type="radio" name="visitType" class="check-card sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">อุบัติเหตุในงาน</div></label>
                                <label class="cursor-pointer"><input type="radio" name="visitType" class="check-card sr-only"><div class="p-2 border border-slate-700 rounded-lg text-center text-xs font-semibold hover:bg-slate-800 transition">อุบัติเหตุทั่วไป</div></label>
                                <label class="cursor-pointer"><input type="radio" name="visitType" class="check-card sr-only"><div class="p-2 border border-red-900/50 text-red-400 rounded-lg text-center text-xs font-semibold hover:bg-red-900/30 transition">ป่วยฉุกเฉิน</div></label>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-400 mb-1">อาการสำคัญ (CC - Chief Complaint)</label>
                                <input type="text" id="emrCC" placeholder="ระบุอาการ + ระยะเวลา" class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm transition">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-400 mb-1">อาการปัจจุบัน (PI - Present Illness)</label>
                                <textarea rows="3" id="emrPI" placeholder="รายละเอียดอาการปัจจุบัน..." class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2 focus:border-emerald-500 focus:outline-none text-sm resize-none transition"></textarea>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="lg:col-span-6 space-y-6">
                    <section class="bg-slate-900 rounded-xl border border-slate-800 shadow-lg p-5">
                        <h2 class="text-lg font-semibold text-emerald-300 mb-4 flex items-center gap-2 border-b border-slate-800 pb-3"><i class="fa-solid fa-heart-pulse"></i> 4. สัญญาณชีพ (Vital Signs)</h2>
                        
                        <div class="grid grid-cols-5 gap-3 mb-4">
                            <div class="bg-slate-800 p-2 rounded-lg border border-slate-700 text-center shadow-inner">
                                <span class="text-[10px] font-medium text-slate-400 block uppercase">BP (mmHg)</span>
                                <input type="text" id="vsBP" placeholder="120/80" class="w-full bg-transparent text-center text-sm font-semibold text-emerald-400 outline-none mt-1">
                            </div>
                            <div class="bg-slate-800 p-2 rounded-lg border border-slate-700 text-center shadow-inner">
                                <span class="text-[10px] font-medium text-slate-400 block uppercase">HR (BPM)</span>
                                <input type="number" id="vsHR" placeholder="80" class="w-full bg-transparent text-center text-sm font-semibold text-emerald-400 outline-none mt-1">
                            </div>
                            <div class="bg-slate-800 p-2 rounded-lg border border-slate-700 text-center shadow-inner">
                                <span class="text-[10px] font-medium text-slate-400 block uppercase">RR (BPM)</span>
                                <input type="number" id="vsRR" placeholder="20" class="w-full bg-transparent text-center text-sm font-semibold text-emerald-400 outline-none mt-1">
                            </div>
                            <div class="bg-slate-800 p-2 rounded-lg border border-slate-700 text-center shadow-inner">
                                <span class="text-[10px] font-medium text-slate-400 block uppercase">SpO2 (%)</span>
                                <input type="number" id="vsSpO2" placeholder="98" class="w-full bg-transparent text-center text-sm font-semibold text-emerald-400 outline-none mt-1">
                            </div>
                            <div class="bg-slate-800 p-2 rounded-lg border border-slate-700 text-center shadow-inner">
                                <span class="text-[10px] font-medium text-slate-400 block uppercase">DTX (mg/dL)</span>
                                <input type="number" id="vsDTX" placeholder="-" class="w-full bg-transparent text-center text-sm font-semibold text-emerald-400 outline-none mt-1">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4 mt-4">
                            <div class="bg-slate-800 p-3 rounded-lg border border-slate-700 shadow-inner">
                                <label class="block text-xs font-medium text-slate-400 mb-2">GCS (Glasgow Coma Scale)</label>
                                <div class="flex gap-2">
                                    <select id="gcsE" class="w-1/3 bg-slate-900 border border-slate-600 rounded p-1.5 text-xs text-center focus:border-emerald-500 outline-none transition"><option value="E4">E4</option><option value="E3">E3</option><option value="E2">E2</option><option value="E1">E1</option></select>
                                    <select id="gcsV" class="w-1/3 bg-slate-900 border border-slate-600 rounded p-1.5 text-xs text-center focus:border-emerald-500 outline-none transition"><option value="V5">V5</option><option value="V4">V4</option><option value="V3">V3</option><option value="V2">V2</option><option value="V1">V1</option></select>
                                    <select id="gcsM" class="w-1/3 bg-slate-900 border border-slate-600 rounded p-1.5 text-xs text-center focus:border-emerald-500 outline-none transition"><option value="M6">M6</option><option value="M5">M5</option><option value="M4">M4</option><option value="M3">M3</option><option value="M2">M2</option><option value="M1">M1</option></select>
                                </div>
                            </div>
                            <div class="bg-slate-800 p-3 rounded-lg border border-slate-700 shadow-inner">
                                <label class="block text-xs font-medium text-slate-400 mb-2">Pupils (mm & React)</label>
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs font-bold text-slate-400 w-4">Rt.</span>
                                        <input type="number" id="pupilR_mm" placeholder="mm" class="w-12 bg-slate-900 border border-slate-600 rounded p-1.5 text-xs text-center focus:border-emerald-500 outline-none transition">
                                        <select id="pupilR_react" class="flex-1 bg-slate-900 border border-slate-600 rounded p-1.5 text-xs focus:border-emerald-500 outline-none transition">
                                            <option value="RTL">RTL</option><option value="Sluggish">Sluggish</option><option value="Fixed">Fixed</option>
                                        </select>
                                    </div>
                                    <div class="flex items-center gap-2">
