        function initFirebaseListeners() {
            // Listen to Inventory
            db.collection("inventory").onSnapshot((snapshot) => {
                if(snapshot.empty) seedFirebase('inventory', inventory); // Auto-seed if empty
                inventory = [];
                snapshot.forEach(doc => inventory.push(doc.data()));
                updateItemList();
                renderInventoryTable();
            });

            // Listen to Patients
            db.collection("patients").onSnapshot((snapshot) => {
                if(snapshot.empty) seedFirebase('patients', patientsDB);
                patientsDB = [];
                snapshot.forEach(doc => patientsDB.push(doc.data()));
                renderPatientTable();
            });

            // Listen to Visit Logs
            db.collection("visits").orderBy("timestamp", "desc").onSnapshot((snapshot) => {
                if(snapshot.empty) seedFirebase('visits', visitLogs);
                visitLogs = [];
                snapshot.forEach(doc => visitLogs.push(doc.data()));
                if(Object.keys(charts).length === 0) initCharts();
                renderReports();
            });
        }

        // Helper to seed data automatically on first run
        async function seedFirebase(collectionName, dataArray) {
            console.log(`Seeding ${collectionName} to Firebase...`);
            for (const item of dataArray) {
                const docId = collectionName === 'patients' ? item.hn : (collectionName === 'inventory' ? item.id : null);
                if (docId) {
                    await db.collection(collectionName).doc(docId).set(item);
                } else {
                    await db.collection(collectionName).add(item);
                }
            }
        }

        function switchView(viewId) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(`view-${viewId}`).classList.add('active');
            document.getElementById(`nav-${viewId}`).classList.add('active');
            if(viewId === 'reports') renderReports();
        }

        function quickSearchPatient() {
            const q = document.getElementById('quickSearchInput').value.toLowerCase();
            if(!q) return;
            const p = patientsDB.find(x => x.hn.toLowerCase() === q || x.name.toLowerCase().includes(q));
            
            if(p) {
                document.getElementById('patHn').value = p.hn; document.getElementById('patName').value = p.name;
                document.getElementById('patGender').value = p.gender; document.getElementById('patAge').value = p.age;
                document.getElementById('patNat').value = p.nationality; document.getElementById('patCompany').value = p.company;
                document.getElementById('patMed').value = p.med; document.getElementById('patAllergy').value = p.allergy;
                
                // Show History
                renderPatientHistory(p.hn);
