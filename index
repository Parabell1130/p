            const vsInfo = log.vs ? `
                <div class="grid grid-cols-5 gap-2 mt-2">
                    <div class="bg-slate-900/50 p-2 rounded border border-slate-700 text-center shadow-inner"><span class="text-[10px] text-slate-400 block uppercase">BP</span><span class="text-emerald-300 font-medium">${log.vs.bp}</span></div>
