                        <div>
                            <h4 class="text-emerald-400 font-semibold mb-2 flex items-center gap-2"><i class="fa-solid fa-user-doctor"></i> การตรวจร่างกาย (PE)</h4>
                            <div class="text-slate-300 bg-slate-900/50 p-3 rounded border border-slate-700 text-sm min-h-[60px]">
                                ${log.pe || '-'}
